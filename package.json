{
  "name": "steam-explorer",
  "version": "1.0.0",
  "description": "Steam Web App using Internal Steam Web API",
  "scripts": {
    "dev": "vite",
    "server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "vite build",
    "build:full": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
